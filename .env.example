# ============================================================
# J.A.R.V.I.S v3 – Vercel edition (no backend of its own)
# These variables go into Vercel: Project -> Settings -> Environment Variables
# All are optional and free:
#  - Without any keys: sign in with your own Groq key in the dashboard (Settings)
#  - With keys: /api/chat uses them server-side (key never visible in the browser)
# ============================================================

# --- Vercel: Groq key for /api/chat (free, no credit card) ---
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: which Groq model (default openai/gpt-oss-120b; on
# model_not_found /api/chat retries openai/gpt-oss-20b automatically)
GROQ_MODEL=

# --- Vercel: Pi AI fallback (/api/chat -> Ollama "AI Box" on the Pi) ---
# Public Cloudflare tunnel URL of the AI Box. When Groq fails, JARVIS
# answers with the tiny Pi model instead – including MCP tools.
# Setup guide: AIBOX.md. Token stays server-side, never in the browser.
PI_AI_URL=
PI_AI_TOKEN=
PI_AI_MODEL=qwen3:0.6b

# --- Vercel: MCP proxy security (/api/mcp) ---
# Allowed MCP hosts (comma-separated, subdomains included). Default: composio.dev
MCP_ALLOWED_HOSTS=composio.dev
# Allow arbitrary https MCP servers? Only enable deliberately:
MCP_ALLOW_ANY=0
# Composio Connect (https://connect.composio.dev/mcp): consumer key (ck_...).
# When set, /api/mcp injects it server-side as x-consumer-api-key and the
# dashboard creates the MCP server automatically (no key in browser/git):
COMPOSIO_CONSUMER_KEY=

# --- Vercel: Pi Voicebox (/api/tts) ---
# Public Cloudflare tunnel URL of the Piper Voicebox on the Pi.
# When these variables are set, nothing needs to be typed on any device:
# JARVIS speaks via the Pi automatically (the token stays server-side).
# Note: quick tunnel URLs (....trycloudflare.com) change on every tunnel
# restart – update VOICEBOX_URL here afterwards.
VOICEBOX_URL=
VOICEBOX_TOKEN=
VOICEBOX_VOICE=en_GB-alan-medium
