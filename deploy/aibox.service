[Unit]
Description=J.A.R.V.I.S AI Box (Ollama gateway / fallback brain on the Pi)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/aibox
EnvironmentFile=/opt/aibox/aibox.env
ExecStart=/usr/bin/python3 /opt/aibox/aibox.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
