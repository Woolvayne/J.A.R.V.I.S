# J.A.R.V.I.S – .env Vorlage (Raspberry Pi 3B+)
# Kopieren mit:  cp .env.example .env   und dann Keys eintragen.
# ALLES ist kostenlos. Ohne Keys läuft JARVIS über Pollinations (keylos) + Demo-Modus.

# --- ⭐ EMPFEHLUNG: Groq (kostenlos, kein Download, sehr schnell, Tool-Calling für MCP) ---
# Key holen: https://console.groq.com/keys  (Login reicht, KEINE Kreditkarte)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative mit viel höherem Gratis-Limit: llama-3.1-8b-instant

# --- Backup: Google Gemini (kostenlos, sehr großzügig) ---
# Key holen: https://aistudio.google.com/apikey  (KEINE Kreditkarte)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Weitere kostenlose Anbieter (optional, alle OpenAI-kompatibel) ---
# Cerebras: https://cloud.cerebras.ai  (sehr schnell)
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b
# Mistral (EU, Experiment-Plan kostenlos, Telefon-Verifizierung): https://console.mistral.ai
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# OpenRouter (viele :free-Modelle, ohne Guthaben 50 Anfragen/Tag): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# Reihenfolge der Anbieter (Komma-Liste). Verfügbare IDs:
# groq, gemini, cerebras, mistral, openrouter, pollinations, ollama, demo
LLM_ORDER=groq,gemini,cerebras,mistral,openrouter,pollinations,demo

# Ollama lokal ist auf dem Pi 3B+ DEAKTIVIERT (1 GB RAM reicht nicht sinnvoll).
# Nur auf stärkeren Geräten aktivieren:
ENABLE_OLLAMA=0
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# --- MCP (Model Context Protocol): beliebige MCP-Server anbinden ---
MCP_ENABLED=1
MCP_SERVERS_FILE=mcp_servers.json
MCP_TIMEOUT=20

# --- Stimme (Edge TTS, kostenlos, kein Key) ---
# Deutsch männlich (JARVIS): de-DE-ConradNeural | weiblich: de-DE-KatjaNeural
TTS_VOICE=de-DE-ConradNeural
TTS_RATE=-5%

# --- Server / Pi ---
PI_MODE=1
HOST=0.0.0.0
PORT=8000
LLM_TIMEOUT=25
