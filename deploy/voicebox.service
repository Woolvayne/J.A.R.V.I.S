[Unit]
Description=J.A.R.V.I.S Voicebox (Piper TTS auf dem Pi)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/voicebox
EnvironmentFile=/opt/voicebox/voicebox.env
ExecStart=/usr/bin/python3 /opt/voicebox/voicebox.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
