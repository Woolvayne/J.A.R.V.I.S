# ============================================================
# J.A.R.V.I.S v2 – Vercel-Edition (ohne eigenes Backend)
# Diese Variablen kommen in Vercel: Project → Settings → Environment Variables
# ALLE sind optional und kostenlos:
#  - Ohne Keys: per eigenem Groq-Key im Dashboard (⚙) oder Pollinations/Demo
#  - Mit Keys: /api/chat nutzt sie serverseitig (Key nie im Browser sichtbar)
# Lokal gilt diese Datei nur noch für das optionale Pi-Backend (.env auf dem Pi).
# ============================================================

# --- Vercel: LLM-Keys für /api/chat (kostenlos, keine Kreditkarte) ---
# Groq ⭐: https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter (:free): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cerebras: https://cloud.cerebras.ai  |  Mistral: https://console.mistral.ai
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# --- Vercel: MCP-Proxy-Sicherheit (/api/mcp) ---
# Erlaubte MCP-Hosts (Komma-Liste, Subdomains inklusive). Standard: composio.dev
MCP_ALLOWED_HOSTS=composio.dev
# Beliebige https-MCP-Server erlauben? Nur bewusst aktivieren:
MCP_ALLOW_ANY=0

# ============================================================
# NUR für das optionale Pi-Backend (backend/, install-pi.sh)
# ============================================================
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# LLM_ORDER=groq,gemini,cerebras,mistral,openrouter,pollinations,demo
# ENABLE_OLLAMA=0
# OLLAMA_MODEL=qwen2.5:0.5b
# OLLAMA_TIMEOUT=120
# MCP_ENABLED=1
# MCP_SERVERS_FILE=mcp_servers.json
# MCP_TIMEOUT=20
# TTS_VOICE=de-DE-ConradNeural
# TTS_RATE=-5%
# PI_MODE=1
# HOST=0.0.0.0
# PORT=8000
# LLM_TIMEOUT=25
